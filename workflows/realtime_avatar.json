{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-dev-fp8.safetensors"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__SOURCE_FRAME__"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__FACE_IMAGE__"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__TARGET_IMAGE__"
    }
  },
  "5": {
    "class_type": "DWPosePreprocessor",
    "inputs": {
      "detect_hand": "enable",
      "detect_body": "enable",
      "detect_face": "enable",
      "resolution": 512,
      "image": ["2", 0]
    }
  },
  "6": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "control_v11p_sd15_openpose.pth"
    }
  },
  "7": {
    "class_type": "ControlNetApply",
    "inputs": {
      "strength": 0.85,
      "image": ["5", 0],
      "control_net": ["6", 0],
      "model": ["1", 0]
    }
  },
  "8": {
    "class_type": "IPAdapterModelLoader",
    "inputs": {
      "ipadapter_file": "ip-adapter-faceid-plusv2_sdxl.bin"
    }
  },
  "9": {
    "class_type": "IPAdapterInsightFaceLoader",
    "inputs": {
      "provider": "CPU"
    }
  },
  "10": {
    "class_type": "IPAdapterApplyFaceID",
    "inputs": {
      "weight": 0.85,
      "weight_faceidv2": 1.0,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only",
      "model": ["7", 0],
      "ipadapter": ["8", 0],
      "image": ["3", 0],
      "insightface": ["9", 0]
    }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__PROMPT__",
      "clip": ["1", 1]
    }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__NEGATIVE_PROMPT__",
      "clip": ["1", 1]
    }
  },
  "13": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "batch_size": 1
    }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["11", 0],
      "negative": ["12", 0],
      "latent_image": ["13", 0]
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["14", 0],
      "vae": ["1", 2]
    }
  },
  "16": {
    "class_type": "ReActorFaceSwap",
    "inputs": {
      "enabled": true,
      "swap_model": "inswapper_128.onnx",
      "facedetection": "retinaface_resnet50",
      "face_restore_model": "GFPGANv1.4.pth",
      "face_restore_visibility": 1.0,
      "see_coder_visibility": 1.0,
      "input_faces_order": "large-small",
      "source_faces_order": "large-small",
      "face_load_source": "input_image",
      "input_image": ["15", 0],
      "source_image": ["4", 0]
    }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "RealtimeAvatar_Shimi",
      "images": ["16", 0]
    }
  }
}
